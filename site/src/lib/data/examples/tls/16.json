	{
		"title": "legacy_session_id is copied, never interpreted",
		"kind": "text",
		"request": "The client puts 32 random bytes in legacy_session_id (what every browser does), or zero bytes, or seven.",
		"request_hex": "",
		"response": "server_hello.legacy_session_id_echo holds exactly those bytes, with exactly that length.",
