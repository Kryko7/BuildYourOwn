	{
		"title": "Why refusing is the sane default",
		"kind": "text",
		"request": "0-RTT data is sent before the server has said anything, so it cannot be bound to a fresh exchange.",
		"request_hex": "",
		"response": "An attacker who captures it can replay it, and the server cannot tell the copy from the original without state it may not have.",
		"response_hex": "",
		"note": "RFC 8446 appendix E.5 is explicit: applications must not use 0-RTT for anything non-idempotent. Advertising it is opt-in per ticket, and refusing an offer is always allowed.",
		"request_fields": [],
		"response_fields": []
	}
