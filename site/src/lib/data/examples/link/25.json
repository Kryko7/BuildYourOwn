	{
		"title": "Why there is no range check",
		"kind": "text",
		"command": "ld -o prog table.o",
		"request": "A jump table of eight-byte entries, each an R_X86_64_64 against a label with a different addend",
		"request_hex": "",
		"response": "Each entry holds S + A. The field is 64 bits wide and the address space is 64 bits wide, so unlike R_X86_64_32 and R_X86_64_PC32 there is no value that can fail to fit and nothing to diagnose",
		"response_hex": "",
		"note": "Addends on pointers are how a compiler writes `&array[3]` or a pointer to a struct field, so they are common rather than exotic.",
		"request_fields": [],
		"response_fields": []
	}
]
