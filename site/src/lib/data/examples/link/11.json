	{
		"title": "A counter that has to be writable",
		"kind": "object",
		"command": "ld -o prog counter.o",
		"request": "counter.o: .data holds the four bytes `25 00 00 00` (37); .text loads them, doubles the value, stores it back, reloads it and exits with it",
